{
  "name": "moviechooser",
  "version": "0.1.0",
  "description": "Desktop app that recommends movies and series available on streaming platforms",
  "main": "dist-electron/main.js",
  "author": "PedroEmmanuelBuerger",
  "license": "MIT",
  "private": true,
  "homepage": "./",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json && vite build && node scripts/copy-windows-assets.mjs",
    "preview": "vite preview",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "npm run build && electron-builder --win --dir --config electron-builder.yml",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:tmdb": "vite-node scripts/test-tmdb.ts",
    "test:recommendation": "vite-node scripts/test-recommendation.ts",
    "test:storage": "vite-node scripts/test-storage.ts",
    "test:settings": "vite-node scripts/test-settings.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.3.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^6.3.5",
    "vite-node": "^6.0.0",
    "wait-on": "^8.0.3"
  }
}
